# Copy to .env.local. Server-only — never prefix with NEXT_PUBLIC_.
# Free key: https://console.groq.com/keys. Without it, agents use the built-in heuristic.
GROQ_API_KEY=

# Local Postgres (sessions, deals, hands). Create the DB, then: npm run db:setup
#   createdb near_poker
DATABASE_URL=postgres://localhost:5432/near_poker
