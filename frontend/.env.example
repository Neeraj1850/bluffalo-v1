# Copy to .env.local. Only NEXT_PUBLIC_ values reach the browser; everything else stays server-side.
# NEAR AI Cloud (https://cloud.near.ai). Without it, the app reports the agent service as down.
# Optional model overrides (defaults are TEE-attested): see GET https://cloud-api.near.ai/v1/models
NEAR_AI_API_KEY=
# NEAR_AI_AGENT_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
# NEAR_AI_HOUSE_MODEL=z-ai/glm-5.3-flash

# Storage backend (backend/, FastAPI + Postgres). Server-only.
# BACKEND_TOKEN must equal BACKEND_TOKEN in backend/.env (openssl rand -hex 32).
BACKEND_URL=http://localhost:8000
BACKEND_TOKEN=

# Privy (https://dashboard.privy.io). The app ID is public; the secret is server-only.
# Without NEXT_PUBLIC_PRIVY_APP_ID the app still runs, but the Connect screen disables sign-in.
# Dashboard: enable Email and Wallet login methods, and add your origins (http://localhost:3000, prod URL)
# under Configuration > App settings > Domains.
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional: an app client ID (Configuration > App settings > Clients), e.g. per-environment settings.
NEXT_PUBLIC_PRIVY_CLIENT_ID=
PRIVY_APP_SECRET=
# Optional: the app's JWT verification public key (Configuration > App settings > Verification key, PEM).
# When set, access tokens are verified locally with no JWKS fetch. "\n" escapes are accepted.
PRIVY_VERIFICATION_KEY=
# Automated / E2E login: enable "Test accounts" in the dashboard (User management > Authentication >
# Advanced). Privy then issues a fixed test email + OTP code that logs in without a real inbox.

# NEAR testnet (contracts/poker). Server-only. The operator key is the private_key in
# ~/.near-credentials/testnet/<operator>.json — it commits/settles hands and funds agents.
NEAR_RPC_URL=https://test.rpc.fastnear.com
NEAR_CONTRACT_ID=bluffalo-poker-mwd58e1p.testnet
NEAR_OPERATOR_ID=npoker-op-43b602.testnet
NEAR_OPERATOR_KEY=
